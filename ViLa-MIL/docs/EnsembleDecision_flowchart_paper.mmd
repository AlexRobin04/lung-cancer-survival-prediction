flowchart TB
    subgraph S0["阶段一：基础融合"]
      direction LR
      A[输入特征 X] --> B[五路基线 MIL]
      B --> C[分支 logits]
      C --> D[概率映射 Softmax]
      D --> E[avg_prob 融合]
      E --> F[基础风险 r_base]
    end

    subgraph S1["阶段二：稳健增强"]
      direction LR
      G[历史排序<br/>best / second] --> H{best 历史预测可用?}
      H -- 是 --> I[复用最强分支概率]
      H -- 否 --> J[使用融合概率]
      I --> K[轻量校准 r_lambda]
      J --> K
      K --> L{稳健门控}
      L -- 通过 --> M[输出 r_lambda]
      L -- 回退 --> N[输出 r_0]
    end

    F --> G
    M --> O[最终风险分数]
    N --> O

    P[门控条件：lambda 上限 / 时间切分验证 / 最小提升阈值]
    L -. 约束 .-> P

    classDef stage fill:#F8FAFF,stroke:#8AA1D4,stroke-width:1.2px,color:#111;
    classDef main fill:#EAF3FF,stroke:#5B8FF9,stroke-width:1.2px,color:#111;
    classDef enhance fill:#FFF2E8,stroke:#FA8C16,stroke-width:1.2px,color:#111;
    classDef output fill:#F6FFED,stroke:#52C41A,stroke-width:1.2px,color:#111;
    classDef note fill:#FAFAFA,stroke:#999,stroke-dasharray: 4 3,color:#333;

    class A,B,C,D,E,F main;
    class G,H,I,J,K,L,M,N enhance;
    class O output;
    class P note;
